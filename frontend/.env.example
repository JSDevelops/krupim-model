# Local PostgreSQL (Laragon default)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/krupim_local

# Generate a unique value with at least 32 characters. Use the same value in backend/.env.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Used to encrypt AI API keys stored in PostgreSQL. Keep this stable or saved keys cannot be decrypted.
# If omitted, AUTH_SECRET is used as the encryption key.
AI_SETTINGS_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters

# Server-only AI secrets. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRIPO_API_KEY=
THREE_D_AI_STUDIO_API_KEY=

# Password reset email. Mailpit/Laragon defaults: host 127.0.0.1, port 1025, no credentials.
APP_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KruPIM FINE Model <no-reply@krupim.local>
