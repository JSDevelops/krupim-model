# Local PostgreSQL (Laragon default)
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/krupim_local

# Generate a unique value with at least 32 characters. Keep it stable across deployments.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Used to encrypt AI API keys stored in PostgreSQL. Keep this stable or saved keys cannot be decrypted.
# If omitted, AUTH_SECRET is used as the encryption key.
AI_SETTINGS_ENCRYPTION_KEY=replace-with-a-separate-random-secret-at-least-32-characters

# Server-only AI secrets. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
TRIPO_API_KEY=
THREE_D_AI_STUDIO_API_KEY=

# Password reset email. Mailpit/Laragon defaults: host 127.0.0.1, port 1025, no credentials.
APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=KruPIM FINE Model <no-reply@krupim.local>

# Optional PostgreSQL pool tuning. Total connections can grow with each Vercel Function instance.
# Local default: 10. Vercel default: 2. Set 2 explicitly in Vercel for predictable capacity.
APP_SERVICE_NAME=krupim-next-fullstack
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Vercel must use Railway's public TCP URL and TLS because it is outside Railway's private network.
# Keep disable/true locally; set require/false in Vercel.
DATABASE_SSL=disable
DATABASE_SSL_REJECT_UNAUTHORIZED=true
