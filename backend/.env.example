# ============================================================
# FINE MODEL Backend — Environment Variables Template
# ============================================================
# 1. Copy ไฟล์นี้เป็น .env  →  cp .env.example .env
# 2. ใส่ค่าจริง (ห้าม commit .env ขึ้น git!)
# 3. สำหรับ Production (Railway) → ตั้งค่าใน Railway Dashboard > Variables
# ============================================================

PORT=3001

# ── AI Provider: Gemini ────────────────────────────────────────────────────────
# สร้าง Key ได้ที่: https://aistudio.google.com/app/apikey
# Key ต้องขึ้นต้นด้วย "AIzaSy..."
GEMINI_API_KEY=AIzaSy_your_gemini_key_here

# ── Database: Supabase ─────────────────────────────────────────────────────────
# ดูได้ที่: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...your_service_role_key

# ── 3D Generation APIs (Optional) ──────────────────────────────────────────────
# Tripo3D: https://platform.tripo3d.ai/api-keys
TRIPO_API_KEY=

# 3D AI Studio: https://3daistudio.com
THREE_D_AI_STUDIO_API_KEY=

# ── AI Fallback Providers (Optional) ──────────────────────────────────────────
# OpenAI: https://platform.openai.com/api-keys  (key starts with "sk-...")
OPENAI_API_KEY=

# Anthropic Claude: https://console.anthropic.com  (key starts with "sk-ant-...")
ANTHROPIC_API_KEY=

# ── CORS: Production Whitelist ─────────────────────────────────────────────────
# ระบุ URL จริงเท่านั้น คั่นด้วย comma
ALLOWED_ORIGINS=http://localhost:3000,https://www.krupim-finemodel3d-ar.com,https://krupim-finemodel3d-ar.com,https://krupim-model.vercel.app
